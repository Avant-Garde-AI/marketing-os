import { Agent } from "@mastra/core/agent";
import { Memory } from "@mastra/memory";
import { storage } from "../storage";
import { getTenantStorage } from "../tenant-storage";
import { shopifyAdminTools } from "../tools/shopify-admin";
import { dispatchToGithubTool } from "../tools/dispatch-to-github";
import { prStatusTool } from "../tools/pr-status";
import { ga4Tools } from "../tools/ga4-reporting";
import { metaAdsTools } from "../tools/meta-ads";
import { semanticTools } from "../tools/semantics";
import { chartTools } from "../tools/chart-tools";
import { chartOfferPerformance } from "../tools/offer-performance";
import { proposeOffer } from "../tools/offer-design";
import { reviewOfferExperiment } from "../tools/offer-review";
import { getExternalMcpTools, getExternalMcpInstructions } from "../tools/external-mcp";
import { brandSoulTools } from "../tools/brand-soul";
import { designSurfaceTools } from "../tools/design-surfaces";
import { imageryTools } from "../tools/imagery";
import { socialTools } from "../tools/social";
import { actionTools } from "../tools/actions";
import { emailTools } from "../tools/email";
import { emailAuthoringTools } from "../tools/email-authoring";
import { getEmailEnablement } from "../../../lib/email/enablement";
import { instructions as emailInstructions } from "../../../lib/email/instructions";
import { instructions as socialInstructions } from "../../../lib/social/instructions";
import { getBrandInstructions, getAgentOverrideInstructions } from "../brand/store";
import { getTenant } from "../../../lib/tenant-context";

/**
 * Marketing Agent
 *
 * The primary conversational agent that users interact with via the console chat.
 *
 * Capabilities:
 * - Answer questions about store performance using analytics tools
 * - Generate ad copy, creative briefs, and marketing content
 * - Execute marketing skills when the user requests them
 * - Dispatch storefront changes to the async pipeline (via GitHub issues)
 * - Provide strategic marketing recommendations
 */
// Memory backing (spec 11 §3.2 / H2). Hosted (pooled) mode resolves memory
// PER TENANT, PER REQUEST from the tenant's own Postgres schema: the dynamic
// function runs inside runWithTenant, so getTenantStorage() sees the correct
// tenant via AsyncLocalStorage and Mastra's thread/message tables live in
// tenant_<slug>. Client-owned mode uses the static single-schema store (or no
// memory at all when no DB is configured, so the console still builds/runs).
// This is what makes thread↔memory continuity real (Slack + console): callers
// pass { memory: { thread, resource } } to the agent and the runtime keys
// persistence on it. See app/api/chat/route.ts.
const HOSTED = process.env.MARKETING_OS_MODE === "hosted";
// Auto-titling: Mastra names each thread after its first exchange using this
// model, and calls updateThread itself — no custom title-generation code
// needed. Flash (not the main agent's model) since this is a one-shot
// classification call, not the analytics tool loop.
const TITLE_GENERATION = {
  model: "google/gemini-2.5-flash",
  instructions:
    "Generate a concise 3-6 word title summarizing what this conversation " +
    "is about. No trailing punctuation, no quotes.",
} as const;
const memory = HOSTED
  ? async () =>
      new Memory({
        storage: await getTenantStorage(),
        options: { generateTitle: TITLE_GENERATION },
      })
  : storage
    ? new Memory({ storage, options: { generateTitle: TITLE_GENERATION } })
    : undefined;

// Base tool map. In hosted mode a tenant's enabled external MCP servers
// (spec 18) are merged on top per request via the dynamic `tools` function
// below — the fetch is TTL-cached per tenant in external-mcp.
const baseMarketingTools = {
  ...chartTools,
  chartOfferPerformance,
  proposeOffer,
  reviewOfferExperiment,
  ...semanticTools,
  ...brandSoulTools,
  ...designSurfaceTools,
  // Imagery resolution (reads: generates candidates, publishes nothing).
  ...imageryTools,
  ...socialTools,
  // spec 20 A1: the agent's ONLY write interface — proposes a governed Action
  // for human approval. Execute paths are structurally unreachable from here
  // (they live behind the platform gate's service secret).
  ...actionTools,
  ...shopifyAdminTools,
  ...ga4Tools,
  ...metaAdsTools,
  dispatchToGithub: dispatchToGithubTool,
  prStatus: prStatusTool,
};

// Brand Soul context (spec 22 BS4/D5): the distilled brand.md front matter is
// appended to instructions per request, TTL-cached. In this client-owned
// deployment brand.md reads files-first from agents/brand/ (D1). Empty string
// when no brand.md exists — never an error, never a blocked turn.
async function brandContext(): Promise<string> {
  try {
    return await getBrandInstructions(getTenant().shop);
  } catch {
    return "";
  }
}

// Store-owned agent creative direction (AGENT.md), appended last so a store can
// steer creative work (e.g. lead with its art knowledge graph) — never relaxes
// safety or the Action gate. Empty string when the store has none.
async function agentOverride(): Promise<string> {
  try {
    return await getAgentOverrideInstructions(getTenant().shop);
  } catch {
    return "";
  }
}

/**
 * Today, stated plainly, in the store's own timezone.
 *
 * A model's sense of "now" comes from its training data, so an agent asked to
 * plan "late September" reaches for the most recent September it has ever seen.
 * The first end-to-end console run wrote a campaign id of
 * `2024-09-17-artist-drop-kaethe-butcher`, scheduled it for 2024, and stamped
 * the UTM with 2024 — two years stale, and wrong in three places that a human
 * has to notice separately.
 *
 * This is cheap to prevent and expensive to catch later: the id becomes the
 * directory name in git, the UTM lands in analytics, and the send date drives
 * the calendar. So the date goes in the instructions on every turn, with the
 * weekday, because send-day rules ("Tuesdays and Thursdays") are unusable
 * without it.
 */
function todayLine(): string {
  const tz = process.env.STORE_TIMEZONE || "America/New_York";
  let stamp: string;
  try {
    stamp = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date());
  } catch {
    // A bad STORE_TIMEZONE must not cost the agent its calendar entirely.
    stamp = new Date().toISOString().slice(0, 10);
  }
  const iso = new Date().toISOString().slice(0, 10);
  return (
    `Today is ${stamp} (${iso}, ${tz}).\n` +
    `Every date you write — campaign ids, scheduledAt, UTM campaign names, calendar months — ` +
    `must be derived from that date. Never infer the year from anything else, and never carry ` +
    `a year over from an example. "Next month" and "late September" are relative to today.\n\n`
  );
}

const BASE_INSTRUCTIONS = `You are the Marketing OS agent for a Shopify store.

Your capabilities:
- Answer questions about store performance using analytics tools
- Generate ad copy, creative briefs, and marketing content
- Execute marketing skills when the user requests them
- Dispatch storefront changes to the async pipeline (via GitHub issues)
- Provide strategic marketing recommendations

Your context:
- Read from /docs/ files for brand voice and product knowledge
- Check marketing-os.config.json for enabled integrations
- Use the dispatch-to-github tool for any changes that modify the storefront

Analytics — use the semantic layer first:
- Start with explore_schema to discover the store's marketing data model
  (views, measures, dimensions). It reflects exactly what's connected.
- For any field you haven't used, call describe_field to confirm its meaning
  and provenance before relying on it.
- The semantic views (traffic, acquisition, site_events, commerce) are the
  preferred way to reason about performance. Drop to the raw GA4 tools
  (run_report, etc.) only when the semantic layer can't express the question.
- If a view is unavailable, tell the user exactly what to connect.

Generative UI (the console renders your tool results as components):
- For analytics questions, PREFER the chart_* tools — the console renders them
  as branded charts. Pick by job: chart_revenue_trend (revenue/sales over
  time), chart_channel_breakdown (which channels), chart_landing_conversion
  (which pages convert), chart_sessions_compare (vs prior period), chart_offer_performance (how an
  offer/popup/signup list is doing). After the
  tool result, add ONE short insight sentence — never restate the numbers,
  never add markdown tables or bold; the chart already shows the data.
- For OFFER/popup/signup/list-building requests, use propose_offer: select the
  incentive FROM the persona (early access, content, threshold, story — a
  discount is one option, never the default), write 1-2 variants in the brand
  voice, always include consent text. It renders an approval card with the
  design-loop gates; deploys only on merchant Approve. Never fake urgency or
  scarcity — it is rejected mechanically.
- To review/optimize a running offer test, use review_offer_experiment — it
  renders a decision card; promotion and traffic shifts apply only when the
  merchant clicks. A nightly steward re-tunes surfaces already on the
  thompson policy.
- For theme/code storefront changes, use propose_storefront_change with your
  drafted content. It renders an approval card; the merchant approves or
  requests changes there. Never call dispatchToGithub directly for changes
  the user just asked for — the approval card is the gate.

Rules:
- Write plain prose. No markdown headings/tables/bold, no emojis, no
  exclamation marks — the console renders text as-is (brand voice).
- Always check brand voice guidelines before generating copy
- Never make up performance data — always use tools to fetch real data
- When asked to modify the store, explain that changes go through a PR review
- Be concise and actionable in your responses
- Format data as visual cards/tables when possible`;

export const marketingAgent = new Agent({
  id: "marketing-agent",
  name: "Marketing Agent",
  // Gemini, per spec 16's D-decision: chat surfaces (console + Slack) run on
  // Gemini/GCP and Claude is reserved for Claude Code git-edits. The as-built
  // had stayed on Anthropic long after that call, which meant one lapsed
  // Anthropic balance took the whole console chat down — a coupling the
  // decision existed to remove.
  //
  // Pro rather than Flash: this agent runs a multi-tool loop (graph reads,
  // imagery, campaign authoring) where instruction-following across several
  // sequential calls is the whole job. Flash already handles the one-shot
  // thread-title classification above, which is the shape it suits.
  // Model FALLBACKS, not one model (Mastra normalises an array into its
  // fallback chain). A capacity error is not a bug in anything we control and
  // it is not rare: three consecutive authoring turns were lost to
  // "This model is currently experiencing high demand" from
  // generativelanguage, after the agent had already run two tools. Without a
  // second model, one provider's busy afternoon takes the whole agent down,
  // and the user sees "that didn't go through" with no way to proceed.
  //
  // Ordered by capability, not by cost: Pro first because this agent runs a
  // multi-tool loop where instruction-following across sequential calls is the
  // whole job. Flash is the same provider and a different capacity pool, which
  // covers the common case; the third entry is a DIFFERENT PROVIDER on purpose,
  // because a fallback chain that shares an outage with its primary is
  // decoration. It is skipped automatically when no Anthropic key is set.
  //
  // maxRetries is low per entry: a model under load rarely recovers within one
  // turn, so retrying it is latency the user pays for twice before the
  // fallback is even tried.
  model: [
    { id: "pro", model: "google/gemini-2.5-pro", maxRetries: 1 },
    { id: "flash", model: "google/gemini-2.5-flash", maxRetries: 1 },
    {
      id: "claude",
      model: "anthropic/claude-sonnet-4-5",
      maxRetries: 1,
      enabled: Boolean(process.env.ANTHROPIC_API_KEY),
    },
  ],

  // Step budget. Mastra defaults a chat turn to 5 steps, and an editorial
  // authoring turn does not fit: the first end-to-end console run spent step 1
  // proposing a plan, step 2 reading the artist profile, her works and the
  // gallery wall sets, and steps 3-5 pulling graph facets — then the stream
  // emitted `finish` with every fact in hand and nothing written. The cutoff
  // looked like the agent losing interest rather than hitting a wall, which is
  // the worst kind of limit.
  //
  // 20 matches Mastra's own upper default and leaves room for the full
  // plan -> gather -> write -> summarise arc plus a retry. The real ceiling is
  // the route's maxDuration, not this number; a turn that needs more than 20
  // steps is a workflow, not a chat message.
  defaultOptions: { maxSteps: 20 },
  ...(memory ? { memory } : {}),
  // Instruction merge order: base, then the social skill pack's instructions
  // (spec 24 SM0 — static, same merge point as the Brand Soul context), then
  // (hosted) connected external servers' usage notes, then the per-request
  // brand context.
  // Pack instructions merge in deterministic id order (05 H5.1: base → brand
  // → packs by id — email-campaign < social-media), each pack under its own
  // heading, only when enabled.
  instructions: HOSTED
    ? async () => {
        const email = (await getEmailEnablement()).enabled ? emailInstructions + "\n\n" : "";
        return (
          todayLine() +
          BASE_INSTRUCTIONS +
          "\n\n" +
          email +
          socialInstructions +
          (await getExternalMcpInstructions()) +
          (await brandContext()) +
          (await agentOverride())
        );
      }
    : async () =>
        todayLine() +
        BASE_INSTRUCTIONS +
        "\n\n" +
        (process.env.EMAIL_PACK_ENABLED === "1" ? emailInstructions + "\n\n" : "") +
        socialInstructions +
        // Self-hosted deployments have external MCP connections too — Arthaus
        // has had the Picasso art graph attached and active since July. Gating
        // spec 18 on hosted mode meant this agent was TOLD about graph tools by
        // the email pack's instructions and then handed none of them: it called
        // faceted_discovery, got ToolNotFoundError, and fell back to guessing
        // at the analytics schema.
        (await getExternalMcpInstructions()) +
        (await brandContext()) +
        (await agentOverride()),
  // Both arms merge the tenant's enabled external MCP tools (spec 18) on top of
  // the native tools per request. What differs is how the email pack is gated:
  // hosted checks enablement (05 H1.2: pack enabled AND Klaviyo connected),
  // client-owned reads env (EMAIL_PACK_ENABLED=1 — the deployment IS the tenant).
  tools: HOSTED
    ? async () => ({
        ...baseMarketingTools,
        ...((await getEmailEnablement()).enabled ? { ...emailTools, ...emailAuthoringTools } : {}),
        ...(await getExternalMcpTools()),
      })
    : async () => ({
        ...baseMarketingTools,
        ...(process.env.EMAIL_PACK_ENABLED === "1" ? { ...emailTools, ...emailAuthoringTools } : {}),
        // Same reason as the instructions above. A source that is down or
        // rate-limited contributes no tools and never fails the turn.
        ...(await getExternalMcpTools()),
      }),
});
